{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/optiprofiler/optiprofiler-evolve/blob/main/config.schema.json",
  "title": "OptiProfiler Evolve experiment",
  "description": "Strict configuration for one solver-evolution experiment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/DataConfig"
    },
    "evolution": {
      "$ref": "#/$defs/EvolutionConfig"
    },
    "workers": {
      "$ref": "#/$defs/WorkersConfig"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxConfig"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowConfig"
    },
    "execution": {
      "$ref": "#/$defs/evaluation_execution"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/criterion"
          },
          "patternProperties": {
            "^performance$": {
              "type": "object",
              "properties": {
                "options": {
                  "$ref": "#/$defs/performance_options"
                }
              }
            },
            "^complexity$": {
              "type": "object",
              "properties": {
                "options": {
                  "$ref": "#/$defs/complexity_options"
                }
              }
            },
            "^integrity$": {
              "type": "object",
              "properties": {
                "options": {
                  "$ref": "#/$defs/IntegrityReviewConfig"
                }
              }
            }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/criterion"
            },
            "patternProperties": {
              "^performance$": {
                "type": "object",
                "properties": {
                  "options": {
                    "$ref": "#/$defs/performance_options"
                  }
                }
              },
              "^complexity$": {
                "type": "object",
                "properties": {
                  "options": {
                    "$ref": "#/$defs/complexity_options"
                  }
                }
              },
              "^integrity$": {
                "type": "object",
                "properties": {
                  "options": {
                    "$ref": "#/$defs/IntegrityReviewConfig"
                  }
                }
              }
            }
          },
          "propertyNames": {
            "enum": [
              "smoke",
              "public",
              "validation",
              "hidden"
            ]
          }
        }
      }
    }
  },
  "required": [
    "workers"
  ],
  "$defs": {
    "ComplexityConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "warn",
            "enforce"
          ],
          "default": "warn"
        },
        "max_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.2
        }
      }
    },
    "DataConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "library": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "default": "s2mpj"
        },
        "selection": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        },
        "problem_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "custom_problem_libraries_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "split": {
          "$ref": "#/$defs/SplitConfig"
        }
      }
    },
    "SplitConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.2
        },
        "hidden_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.2
        },
        "smoke_count": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "seed": {
          "type": "integer",
          "default": 0
        },
        "lockbox_required": {
          "type": "boolean",
          "default": false
        },
        "public": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "hidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "smoke": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "EvaluationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "load"
                ]
              },
              {
                "required": [
                  "solvers_to_load"
                ]
              }
            ]
          }
        },
        "smoke_overrides": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "load"
                ]
              },
              {
                "required": [
                  "solvers_to_load"
                ]
              }
            ]
          }
        },
        "backend": {
          "type": "string",
          "enum": [
            "docker",
            "unsafe_local"
          ],
          "default": "docker"
        },
        "docker_image": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 3600
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.0
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "default": "4g"
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 16,
          "default": 512
        },
        "feedback_mode": {
          "type": "string",
          "enum": [
            "score_only",
            "full_artifacts"
          ],
          "default": "score_only"
        },
        "reference": {
          "type": "string",
          "enum": [
            "initial",
            "scipy_nelder_mead",
            "scipy_powell",
            "scipy_cobyla",
            "scipy_cobyqa",
            "pdfo",
            "pdfo_uobyqa",
            "pdfo_newuoa",
            "pdfo_bobyqa",
            "pdfo_lincoa",
            "pdfo_cobyla",
            "prima",
            "prima_uobyqa",
            "prima_newuoa",
            "prima_bobyqa",
            "prima_lincoa",
            "prima_cobyla"
          ],
          "default": "initial"
        },
        "fitness_source": {
          "type": "string",
          "enum": [
            "solver_scores",
            "profile_scores_mean"
          ],
          "default": "solver_scores"
        },
        "forbidden_candidate_imports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "max_smoke_calls_per_worker": {
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "max_public_calls_per_worker": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "default": "optiprofiler"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "docker_image"
            ],
            "properties": {
              "docker_image": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "EvolutionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "islands": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "attempts_per_island": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "population_per_island": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "migration_interval": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "random_seed": {
          "type": "integer",
          "default": 0
        },
        "finalists_per_island": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "retention": {
          "$ref": "#/$defs/ComponentConfig",
          "default": {
            "name": "validation_lexicographic"
          }
        },
        "parent_sampler": {
          "$ref": "#/$defs/ComponentConfig",
          "default": {
            "name": "top_biased_validation_weighted",
            "options": {
              "greedy_ratio": 0.7
            }
          }
        }
      }
    },
    "WorkersConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pool": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerConfig"
          },
          "minItems": 1
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1800
        },
        "token_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null
        },
        "prompt_note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000,
          "default": null
        },
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "default": "cli"
        },
        "tools": {
          "$ref": "#/$defs/ToolConfig"
        },
        "allow_direct_provider": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "pool"
      ]
    },
    "WorkerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "pass_env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "provider_gateway": {
          "$ref": "#/$defs/ProviderGatewayConfig"
        }
      },
      "required": [
        "harness",
        "model"
      ]
    },
    "ProviderGatewayConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_base_url": {
          "type": "string",
          "minLength": 1
        },
        "credential_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "auto",
            "anthropic",
            "openai_responses"
          ],
          "default": "auto"
        },
        "auth_mode": {
          "type": "string",
          "enum": [
            "auto",
            "bearer",
            "x-api-key"
          ],
          "default": "auto"
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 16000000
        },
        "connect_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 15
        },
        "response_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 900
        }
      },
      "required": [
        "upstream_base_url",
        "credential_env"
      ]
    },
    "IntegrityReviewConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentConfig",
          "default": {
            "name": "agent_integrity"
          }
        },
        "worker": {
          "oneOf": [
            {
              "$ref": "#/$defs/WorkerConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allow_same_model": {
          "type": "boolean",
          "default": false
        },
        "allow_unsafe_stub": {
          "type": "boolean",
          "default": false
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 600
        },
        "token_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 4000
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null
        }
      }
    },
    "ToolConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "minimal",
            "research",
            "custom"
          ],
          "default": "minimal"
        },
        "web_search": {
          "type": "boolean",
          "default": false
        },
        "network": {
          "type": "boolean",
          "default": true
        },
        "shell": {
          "type": "boolean",
          "default": true
        },
        "python": {
          "type": "boolean",
          "default": true
        },
        "git": {
          "type": "boolean",
          "default": true
        },
        "compilers": {
          "type": "boolean",
          "default": false
        },
        "package_install": {
          "type": "boolean",
          "default": false
        },
        "communication": {
          "type": "string",
          "enum": [
            "none",
            "controller_summary",
            "island",
            "global"
          ],
          "default": "none"
        }
      }
    },
    "ComponentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "options": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        }
      },
      "required": [
        "name"
      ]
    },
    "WorkflowConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "description": "Ordered phases, possibly empty. Required inputs and configured optional producers must precede consumers; dependencies and phase configuration hooks are checked before run startup.",
          "items": {
            "$ref": "#/$defs/ComponentConfig"
          }
        },
        "attempt_steps": {
          "type": "array",
          "description": "Steps constructed for ExplorePhase workflows, validated before startup to include mutate and public_evaluate. Without ExplorePhase, defaults or an empty list are both valid and names are not resolved.",
          "items": {
            "$ref": "#/$defs/ComponentConfig"
          }
        },
        "after_iteration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentConfig"
          }
        }
      }
    },
    "SandboxConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "docker",
            "unsafe_local"
          ],
          "default": "docker"
        },
        "worker_image": {
          "type": "string",
          "minLength": 1,
          "default": "optiprofiler-evolve-worker:latest"
        },
        "gateway_image": {
          "type": "string",
          "minLength": 1,
          "default": "optiprofiler-evolve-gateway:latest"
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.0
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "default": "4g"
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 16,
          "default": 512
        },
        "gateway_cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5
        },
        "gateway_memory": {
          "type": "string",
          "minLength": 1,
          "default": "256m"
        },
        "gateway_pids_limit": {
          "type": "integer",
          "minimum": 16,
          "default": 64
        },
        "gateway_start_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "max_candidate_files": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        },
        "max_candidate_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 200000000
        },
        "allow_direct_network": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "evaluation_execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "docker",
            "unsafe_local"
          ],
          "default": "docker"
        },
        "docker_image": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 3600
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.0
        },
        "memory": {
          "type": "string",
          "minLength": 1,
          "default": "4g"
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 16,
          "default": 512
        },
        "feedback_mode": {
          "type": "string",
          "enum": [
            "score_only",
            "full_artifacts"
          ],
          "default": "score_only"
        },
        "forbidden_candidate_imports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "max_smoke_calls_per_worker": {
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "max_public_calls_per_worker": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "default": "optiprofiler"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "docker_image"
            ],
            "properties": {
              "docker_image": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Defaults to 0 for integrity and 1 for other criteria; explicit weights override these defaults."
        },
        "mode": {
          "enum": [
            "warn",
            "enforce"
          ]
        },
        "options": {
          "type": "object"
        }
      }
    },
    "performance_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "load"
                ]
              },
              {
                "required": [
                  "solvers_to_load"
                ]
              }
            ]
          }
        },
        "smoke_overrides": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "load"
                ]
              },
              {
                "required": [
                  "solvers_to_load"
                ]
              }
            ]
          }
        },
        "reference": {
          "type": "string",
          "enum": [
            "initial",
            "scipy_nelder_mead",
            "scipy_powell",
            "scipy_cobyla",
            "scipy_cobyqa",
            "pdfo",
            "pdfo_uobyqa",
            "pdfo_newuoa",
            "pdfo_bobyqa",
            "pdfo_lincoa",
            "pdfo_cobyla",
            "prima",
            "prima_uobyqa",
            "prima_newuoa",
            "prima_bobyqa",
            "prima_lincoa",
            "prima_cobyla"
          ],
          "default": "initial"
        },
        "fitness_source": {
          "type": "string",
          "enum": [
            "solver_scores",
            "profile_scores_mean"
          ],
          "default": "solver_scores"
        }
      }
    },
    "complexity_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
